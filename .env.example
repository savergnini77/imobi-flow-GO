# =============================================================================
# Imobi Flow GO - Variáveis de ambiente (MODELO)
# =============================================================================
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# NUNCA coloque chaves reais neste arquivo (.env.example é versionado no Git).
# O arquivo ".env.local" é ignorado pelo Git.
#
# Nesta Etapa 1 o projeto roda SEM nenhuma dessas variáveis.
# Elas estão listadas apenas como referência para as próximas etapas.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# URL base da aplicação (usada em links de e-mail, callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase  (a configurar em etapa futura - NÃO usado na Etapa 1)
# -----------------------------------------------------------------------------
# Valores encontrados no painel do Supabase em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta de service role - USAR SOMENTE NO SERVIDOR, nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão direta ao PostgreSQL (migrações / ferramentas de banco)
# DATABASE_URL=postgresql://postgres:[SENHA]@[HOST]:5432/postgres
DATABASE_URL=
