# =============================================================================
# Imobi Flow GO - Variáveis de ambiente (MODELO)
# =============================================================================
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# NUNCA coloque chaves reais neste arquivo (.env.example é versionado no Git).
# O arquivo ".env.local" é ignorado pelo Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# URL pública da aplicação: links de e-mail, callbacks, sitemap, OG image.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (obrigatório)
# -----------------------------------------------------------------------------
# Local: valores exibidos por `npm run db:start`.
# Nuvem: painel do Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta de service role - USAR SOMENTE NO SERVIDOR, nunca expor no cliente.
# (Ainda não usada pelo app; reservada para webhooks de billing no Sprint 6.)
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão direta ao PostgreSQL (migrações / ferramentas de banco)
# DATABASE_URL=postgresql://postgres:[SENHA]@[HOST]:5432/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# Próximas etapas (ainda não usadas)
# -----------------------------------------------------------------------------
# E-mail transacional de convites (Sprint 2)
# RESEND_API_KEY=

# Cobrança (Sprint 6)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
